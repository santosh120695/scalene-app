# ── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | production
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowledgecanvas?sslmode=disable

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-32-char-or-longer-secret

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_DRIVER is inferred from ENVIRONMENT when not set explicitly:
#   production  → oracle  (OCI_* credentials are required; missing = startup failure)
#   development → local   (writes to LOCAL_STORAGE_DIR, served via /api/v1/files/*)
# Override with STORAGE_DRIVER=local | oracle if needed.
# STORAGE_DRIVER=
LOCAL_STORAGE_DIR=./uploads

# Oracle Cloud Object Storage (S3-compatible) — required in production
OCI_ACCESS_KEY=
OCI_SECRET_KEY=
OCI_STORAGE_ENDPOINT=https://{namespace}.compat.objectstorage.ap-mumbai-1.oraclecloud.com
OCI_BUCKET_NAME=knowledgecanvas-files
OCI_REGION=ap-mumbai-1
